{
  "name": "ordana-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Ordana",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
